<Window x:Class="JMComicClient.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="禁漫天堂" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/app.ico"
        Background="#F5F5F5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Grid.Column="0" Background="#2C2C2C">
            <!-- Bottom credit -->
            <TextBlock DockPanel.Dock="Bottom" Text="Made by Nijika"
                       Foreground="#555" FontSize="11"
                       HorizontalAlignment="Left"
                       Margin="16,0,0,10"/>

            <!-- Logo -->
            <Border DockPanel.Dock="Top" Background="#FF4081" Padding="16,20">
                <TextBlock Text="禁漫天堂" FontSize="20" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
            </Border>

            <!-- User info -->
            <Border DockPanel.Dock="Top" Background="#383838" Padding="16,12"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock x:Name="UsernameText" Text="未登录"
                               Foreground="#AAAAAA" FontSize="13"
                               HorizontalAlignment="Center"/>
                    <Button x:Name="LoginLogoutBtn" Content="登录"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="12" Padding="12,4" Margin="0,8,0,0"
                            Click="LoginLogout_Click"/>
                </StackPanel>
            </Border>

            <!-- Nav buttons -->
            <StackPanel>
                <Button x:Name="NavRanking" Content="📊 排行榜"
                        Style="{StaticResource PrimaryButton}"
                        Background="Transparent" Foreground="#CCCCCC"
                        FontSize="14" Padding="20,12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="NavRanking_Click"/>
                <Button x:Name="NavSearch" Content="🔍 搜索"
                        Style="{StaticResource PrimaryButton}"
                        Background="Transparent" Foreground="#CCCCCC"
                        FontSize="14" Padding="20,12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="NavSearch_Click"/>
                <Button x:Name="NavFavorites" Content="❤️ 收藏夹"
                        Style="{StaticResource PrimaryButton}"
                        Background="Transparent" Foreground="#CCCCCC"
                        FontSize="14" Padding="20,12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="NavFavorites_Click"/>
                <Button x:Name="NavDownload" Content="⬇️ 下载管理"
                        Style="{StaticResource PrimaryButton}"
                        Background="Transparent" Foreground="#CCCCCC"
                        FontSize="14" Padding="20,12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="NavDownload_Click"/>
                <Button x:Name="NavSettings" Content="⚙ 设置"
                        Style="{StaticResource PrimaryButton}"
                        Background="Transparent" Foreground="#CCCCCC"
                        FontSize="14" Padding="20,12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="NavSettings_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Content area -->
        <Border Grid.Column="1" Background="#F5F5F5" Margin="0">
            <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>
        </Border>
    </Grid>
</Window>
