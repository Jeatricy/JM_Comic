<Page x:Class="JMComicClient.Views.SearchView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="🔍 搜索" FontSize="24" FontWeight="Bold"
                   Foreground="#333" Margin="0,0,0,16"/>

        <!-- Search bar + filters -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" Grid.Column="0"
                     FontSize="14" Padding="10,8"
                     VerticalContentAlignment="Center"
                     KeyDown="SearchBox_KeyDown"
                     Margin="0,0,8,0">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="White"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <TextBlock Text="输入漫画名称或JM号..."
                                                       Foreground="#BDBDBD"
                                                       FontSize="14"
                                                       Visibility="Collapsed">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <ComboBox x:Name="SortCombo" Grid.Column="1"
                      Width="100" FontSize="13" Margin="0,0,8,0">
                <ComboBoxItem Content="最新" Tag="mr" IsSelected="True"/>
                <ComboBoxItem Content="人气" Tag="mv"/>
                <ComboBoxItem Content="图片数" Tag="mp"/>
                <ComboBoxItem Content="点赞" Tag="tf"/>
            </ComboBox>

            <Button x:Name="SearchBtn" Grid.Column="2"
                    Content="搜索" Style="{StaticResource PrimaryButton}"
                    Click="Search_Click" MinWidth="80"/>
        </Grid>

        <!-- Loading indicator -->
        <TextBlock x:Name="LoadingText" Grid.Row="1"
                   Text="正在搜索..." Foreground="#999"
                   FontSize="13" Margin="0,40,0,0"
                   HorizontalAlignment="Center"
                   Visibility="Collapsed"/>

        <!-- Results -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="ResultsPanel" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- Pagination -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="PrevBtn" Grid.Column="1" Content="◀ 上一页"
                    Style="{StaticResource SecondaryButton}"
                    Click="Prev_Click" Margin="0,0,8,0"
                    Visibility="Collapsed"/>
            <TextBlock x:Name="PageText" Grid.Column="2"
                       Text="第 1 页" FontSize="14"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button x:Name="NextBtn" Grid.Column="3" Content="下一页 ▶"
                    Style="{StaticResource SecondaryButton}"
                    Click="Next_Click"
                    Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>
